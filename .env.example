# Copy to .env and fill in. Values here override config/uploader.toml.

# --- Telegram (required) ---
# api_id / api_hash: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: python scripts/login.py
# Grants full account access. Never commit it.
TELEGRAM_SESSION_STRING=

# --- Destination ---
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# --- Radarr (required for unmonitor/exclude) ---
RADARR_URL=http://radarr:7878
RADARR_API_KEY=