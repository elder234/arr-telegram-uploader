# Copy to .env and fill in. Values here override config/uploader.toml.

# --- Telegram (required) ---
# api_id / api_hash: https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Generate with: python scripts/login.py
# Grants full account access. Never commit it.
TELEGRAM_SESSION_STRING=

# --- Destination ---
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=

# --- Radarr (required for unmonitor/exclude) ---
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# --- TorBox (required for downloads) ---
# Full access to your seedbox. Never commit it.
# https://torbox.app/settings/account
TORBOX_API_KEY=
# Leave empty to disable downloads entirely. Set both to enable.
TORBOX_WATCH_DIR=
# Delete the torrent from TorBox once files are on disk. Off by default: it
# frees server space but is irreversible.
TORBOX_DELETE_AFTER_FETCH=false