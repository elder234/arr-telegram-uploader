# --- Secrets: never commit ---
.env
*.session
*.session-journal
secrets/
*.key
*.pem

# --- Uploader runtime state ---
# The database holds the part ledger and the deletion record; the queue must be
# reproducible, not shared through git.
*.db
*.db-wal
*.db-shm
uploader.db*

# Inbox: Radarr writes payload files here. Transient by design.
inbox/

# Quarantine holds movies whose deletion could not be proven. Local data.
quarantine/

# --- Uploaded artifacts ---
dist/
build/
*.egg-info/
*.tar.gz

# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
.python-version

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Editors and OS ---
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini
.DS_Store
_commitmsg.txt